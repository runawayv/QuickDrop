<Window x:Class="QuickDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.WindowTitle}"
        Width="960" Height="620" MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver"
        DragLeave="OnDragLeave" Drop="OnDrop">

    <Window.Resources>
        <DataTemplate x:Key="TransferTemplate">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="4"
                    Background="{DynamicResource HoverBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DirectionIcon}" Foreground="{DynamicResource Accent}"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Transferring">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,7,0,5"
                                 Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding PercentText}" FontSize="12" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="QuickDrop" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ServerUrl}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/>

                    <Border Background="White" CornerRadius="4" Padding="6"
                            HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Image Source="{Binding QrImage}" Width="140" Height="140"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <Button Content="{DynamicResource L.CopyLink}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OnCopyLink"/>
                </StackPanel>
            </Border>

            <Border x:Name="DropZone" Height="120" Margin="0,12,0,0" CornerRadius="4"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource DropZoneBorder}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M 12 4 L 12 14 M 7 9.5 L 12 14.5 L 17 9.5 M 5 19 L 19 19"
                          Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="26" Height="26" Stretch="Uniform"/>
                    <TextBlock Text="{DynamicResource L.DropTitle}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                    <TextBlock Text="{DynamicResource L.DropSubtitle}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="{DynamicResource L.PickFiles}" Style="{StaticResource ModernButton}"
                        Margin="0,0,4,0" Click="OnPickFiles"/>
                <Button Content="{DynamicResource L.PickFolder}" Style="{StaticResource GhostButton}"
                        Margin="4,0,0,0" Click="OnPickFolder"/>
            </UniformGrid>

            <TextBlock Text="{Binding SharedInfo}" Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" Margin="2,8,0,0"/>
        </StackPanel>

        <!-- Правая колонка -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{DynamicResource L.History}" Style="{StaticResource GhostButton}"
                        Padding="14,7" Click="OnHistory"/>
                <Button Grid.Column="3" Content="{DynamicResource L.Settings}" Style="{StaticResource GhostButton}"
                        Padding="14,7" Click="OnSettings"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,2,4,8">
                        <TextBlock Text="{DynamicResource L.Transfers}" FontSize="14" FontWeight="SemiBold"/>
                        <Button Content="{DynamicResource L.Clear}" HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12"
                                Click="OnClearFinished"/>
                    </Grid>
                    <Grid>
                        <ListBox ItemsSource="{Binding Transfers}"
                                 ItemTemplate="{StaticResource TransferTemplate}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VerticalContentAlignment="Top">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="{DynamicResource L.EmptyTitle}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                            <TextBlock Text="{DynamicResource L.EmptySubtitle}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>