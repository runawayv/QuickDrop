<Window x:Class="QuickDrop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — QuickDrop"
        Width="600" Height="740" MinWidth="520" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,20,24">

            <TextBlock Text="Сервер" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Порт" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PortBox" Style="{StaticResource FieldBox}"
                             Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Text="Сетевой интерфейс" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                    <ComboBox x:Name="AdapterBox" Style="{StaticResource DarkCombo}"
                              DisplayMemberPath="Display" SelectedValuePath="Ip"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Запускать сервер автоматически"
                              Style="{StaticResource DarkCheck}" Margin="2,14,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Файлы" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Папка для файлов с телефона" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}"/>
                        <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="OnBrowseFolder"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Безопасность" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="PinCheck" Content="Требовать PIN при подключении"
                              Style="{StaticResource DarkCheck}"
                              Checked="OnPinChanged" Unchecked="OnPinChanged"/>
                    <TextBlock Text="Новый PIN" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                    <PasswordBox x:Name="PinBox" Style="{StaticResource FieldPassword}" MaxLength="12"/>
                    <TextBlock Text="Повторите PIN" Style="{StaticResource FieldLabel}" Margin="2,12,0,6"/>
                    <PasswordBox x:Name="PinBox2" Style="{StaticResource FieldPassword}" MaxLength="12"/>
                    <TextBlock x:Name="PinHint" Text="" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Интерфейс" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Тема" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ThemeBox" Style="{StaticResource DarkCombo}"
                              Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Тёмная"/>
                        <ComboBoxItem Content="Светлая"/>
                    </ComboBox>

                    <TextBlock Text="Язык / Language" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                    <ComboBox x:Name="LangBox" Style="{StaticResource DarkCombo}"
                              Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>

                    <CheckBox x:Name="AutorunCheck" Content="Запускать вместе с Windows"
                              Style="{StaticResource DarkCheck}" Margin="2,14,0,0"/>
                    <CheckBox x:Name="TrayCheck" Content="При закрытии сворачивать в трей"
                              Style="{StaticResource DarkCheck}" Margin="2,12,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" Style="{StaticResource ModernButton}"
                        Padding="24,9" Click="OnSave"/>
                <Button Content="Отмена" Style="{StaticResource GhostButton}"
                        Padding="24,9" Margin="10,0,0,0" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>